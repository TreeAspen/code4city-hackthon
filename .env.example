# Copy this file to `.env.local` and edit values to enable the live 311 API.
# Vite only exposes vars prefixed with VITE_ to the browser.

# Set to `true` to fetch real-time data from NYC Open Data (Socrata).
# When false (or unset), the dashboard uses the bundled preprocessed JSON.
VITE_USE_LIVE_API=false

# Controls the hackathon "fake overlay" that randomizes complaintType + dates
# into a smooth seasonal curve for visual polish.
# Defaults: ON in Demo mode, OFF in Live mode. Override here if needed.
# VITE_FAKE_OVERLAY=false

# Optional Socrata App Token. Without one, requests are throttled (~per IP/hour).
# Register a free token at https://data.cityofnewyork.us/profile/edit/developer_settings
# VITE_SODA_APP_TOKEN=your_token_here

# ---- Free LLM provider for the Extractor (query → semantic categories) ----
# When nothing below is set, the Extractor falls back to deterministic keyword
# mapping. Provider auto-detection: VITE_GEMINI_API_KEY set → gemini.
# Force a provider with VITE_LLM_PROVIDER=ollama or =gemini.

# Option A — Gemini free tier (recommended for live demos: ~1-2s per query).
# Get a free key at https://aistudio.google.com/apikey
# ⚠ Vite inlines VITE_ vars into the public JS bundle. Only set in .env.local
# for LOCAL demos; NEVER `npm run deploy` (gh-pages) with a key set.
# VITE_GEMINI_API_KEY=...
# VITE_GEMINI_MODEL=gemini-2.0-flash

# Option B — local Ollama (no key at all; latency depends on your hardware).
# Run `ollama pull llama3.1:8b` first. If the browser reports CORS errors,
# restart Ollama with OLLAMA_ORIGINS=* set.
# VITE_LLM_PROVIDER=ollama
# VITE_OLLAMA_MODEL=llama3.1:8b
# VITE_OLLAMA_URL=http://localhost:11434

# The offline tagging script (scripts/tagRecords.mjs) uses the same two
# providers via plain env vars: GEMINI_API_KEY / OLLAMA_MODEL etc. — see the
# header comment in that script.
